{
  "name": "r-type",
  "version": "0.1.0",
  "private": true,
  "description": "R-Type",
  "scripts": {
    "start": "./server/scripts/watch.sh",
    "start:notests": "RUN_TESTS=0 ./server/scripts/watch.sh",
    "build": "cmake -S . -B build -DCMAKE_BUILD_TYPE=Debug && cmake --build build",
    "test": "./build/tests",
    "coverage": "./server/scripts/coverage.sh",
    "clean": "rm -rf build build-coverage",
    "g": "./server/scripts/cppf.sh g"
  }
}